# Sao chép file này thành .env rồi điền khóa thật. KHÔNG commit .env.

# LLM cho các agent (chuỗi model theo chuẩn litellm mà CrewAI dùng)
# Gemini có free tier: https://aistudio.google.com/apikey
MODEL=gemini/gemini-3.8-flash
GEMINI_API_KEY=

# Bot Telegram để gửi kịch bản mỗi sáng (tạo qua @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API v3 — dùng để kiểm tra ý tưởng đã có ai làm chưa (có free quota)
YOUTUBE_API_KEY=

# Tắt telemetry/tracing của CrewAI
CREWAI_TRACING_ENABLED=false
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# Model dự phòng khi model chính quá tải (phân cách bằng dấu phẩy)
MODEL_FALLBACKS=gemini/gemini-3.1-flash-lite,gemini/gemma-4-26b-a4b-it
